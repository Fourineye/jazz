{
  "SceneClass": "Scene",
  "name": "UITestV2",
  "properties": {
    "title": "JSON-Serialized UI Showcase"
  },
  "scripts": {
    "update": "showcase.v2_json.scripts.showcase_hooks.check_space_return"
  },
  "Objects": [
    {
      "Class": "VBox",
      "options": {
        "name": "title_box",
        "pos": [400, 40],
        "anchor": [1, 0],
        "bg_color": [128, 0, 0],
        "border_color": [128, 128, 128],
        "border_width": 3,
        "radius": 5,
        "padding": 10
      },
      "children": [
        {
          "Class": "Label",
          "options": {
            "name": "title_label",
            "text": "UI Components (JSON Serialized)",
            "fontsize": 28,
            "text_color": [255, 255, 255]
          }
        }
      ]
    },
    {
      "Class": "VBox",
      "options": {
        "name": "main_panel",
        "pos": [150, 120],
        "size": [500, 520],
        "bg_color": [40, 40, 45],
        "anchor": [0, 0],
        "padding": 25,
        "spacing": 20,
        "align": "center",
        "radius": 10
      },
      "children": [
        {
          "Class": "Label",
          "options": {
            "name": "header_label",
            "text": "DESERIALIZED FORM INPUTS",
            "fontsize": 22,
            "text_color": [255, 165, 0]
          }
        },
        {
          "Class": "TextBox",
          "options": {
            "name": "user_input",
            "text": "JazzPlayer",
            "size": [300, 40],
            "fontsize": 18,
            "on_submit": "showcase.v2_json.scripts.showcase_hooks.on_form_submit"
          }
        },
        {
          "Class": "ProgressBar",
          "options": {
            "name": "hp_bar",
            "value": 85,
            "max_value": 100,
            "size": [300, 30],
            "color": [50, 200, 50],
            "bg_color": [60, 60, 60],
            "radius": 5
          }
        },
        {
          "Class": "Button",
          "options": {
            "name": "submit_btn",
            "size": [200, 45],
            "label": "Submit Form",
            "text_size": 16,
            "callback": "showcase.v2_json.scripts.showcase_hooks.return_to_menu"
          }
        },
        {
          "Class": "Label",
          "options": {
            "name": "status_label",
            "text": "Status: Ready",
            "fontsize": 16,
            "text_color": [200, 200, 200]
          }
        }
      ]
    },
    {
      "Class": "Label",
      "options": {
        "name": "hint_label",
        "text": "Press [Space] or click Submit to return to Menu",
        "pos": [400, 720],
        "anchor": [1, 0.5],
        "fontsize": 18,
        "text_color": [160, 160, 160]
      }
    }
  ]
}
